<%- include('partials/header') %>
    <main>
        <h1>Dashboard</h1>
        <p>Welcome, <%= name %>! Your email is <%= email %>.</p>

        <h2>Projects You're Volunteering For</h2>
        <% if (volunteeredProjects.length> 0) { %>
            <ul>
                <% volunteeredProjects.forEach(project=> { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                        (<%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                            day: 'numeric' }) %>)
                            <form action="/project/<%= project.project_id %>/unvolunteer" method="POST"
                                style="display:inline;">
                                <input type="hidden" name="redirectTo" value="dashboard" />
                                <button type="submit">Remove</button>
                            </form>
                    </li>
                    <% }) %>
            </ul>
            <% } else { %>
                <p>You haven't signed up to volunteer for any projects yet.</p>
                <% } %>

                    <% if (user && user.role_name==='admin' ) { %>
                        <p><a href="/users">View All Registered Users</a></p>
                        <% } %>
    </main>
    <%- include('partials/footer') %>